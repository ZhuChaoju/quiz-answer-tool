<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>quiz-answer-tool</AssemblyName>
    <RootNamespace>QuizAnswerTool</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="RapidOcrNet" Version="3.0.0" />
    <!-- ORT 1.27（RapidOcrNet 传递依赖）的 Windows 原生库已内置 DirectML EP，ocr.use_dml=true 即启用 GPU，无需额外包 -->
  </ItemGroup>

  <ItemGroup>
    <!-- 通配符包含：模型文件 git 忽略、按需手动下载（tiny/small/medium 任选），
         目录为空或缺某档文件时构建不报错，运行时自动回退到已有档位 -->
    <None Include="models\v6\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 数据文件本地存在才拷贝：新机器克隆后未准备题库/配置时构建不报错（运行时已有回退） -->
    <None Include="questions.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('questions.json')" />
    <None Include="config.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('config.json')" />
  </ItemGroup>

</Project>
